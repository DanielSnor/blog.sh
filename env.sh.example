#!/usr/bin/env bash
# Environment for blog.sh -- secrets and anything environment-specific.
# Deliberately separate from config/site.yml: site.yml is versioned and
# synced across environments (so a local build renders the same site as
# production and changes have history), while this file holds tokens and
# per-environment values that must never end up in git.
#
# Copy this file to env.sh (gitignored -- see .gitignore), fill in the
# values you need, and `chmod 600 env.sh` since it holds live credentials.
# blog.sh/deploy-web.sh/refresh-sidebar.sh all `source` it before running.

# Required for a live site: the canonical URL posts/RSS/sitemap/OG tags are
# built from. Overrides config/site.yml's site.base_url if both are set --
# this is the one value allowed to depend on the environment (e.g. a local
# or staging build pointing somewhere other than production).
export SITE_BASE_URL=https://example.com

# Optional. Only needed if config/site.yml has a `mastodon:` section --
# without a token, ./blog.sh still works, it just never posts a toot or
# fetches post stats. Create one on the target instance under
# Preferences -> Development -> New application, scope write:statuses.
export MASTODON_ACCESS_TOKEN=

# Optional. Only needed to run scripts/migrate_tumblr.rb (a one-time import
# from a Tumblr blog) -- unused otherwise. Get one from
# https://www.tumblr.com/oauth/apps.
export TUMBLR_API_KEY=

# Optional, but all three are required together for ./deploy-web.sh and
# ./blog.sh rebuild to actually upload anything -- without them, uploads are
# skipped (logged, not an error), which is convenient for a local-only build.
# SURFER_URL is the Cloudron app's base URL (Files API lives at
# <SURFER_URL>/api/files/...); SURFER_REMOTE_DIR is the subdirectory posts
# get uploaded under (leave empty to upload at the app's root).
export SURFER_URL=
export SURFER_TOKEN=
export SURFER_REMOTE_DIR=

# Optional, for scripts/migrate_twitter.rb only: caps how many tweets are
# processed in one run, useful for a quick test pass before a full import.
# Leave unset to import everything.
# export LIMIT=50
