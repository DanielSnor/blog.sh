#!/usr/bin/env bash
# Environment for blog.sh -- secrets and anything environment-specific.
# Deliberately separate from config/site.yml: site.yml is versioned and
# synced across environments (so a local build renders the same site as
# production and changes have history), while this file holds tokens and
# per-environment values that must never end up in git.
#
# Copy this file to env.sh (gitignored -- see .gitignore), fill in the
# values you need, and `chmod 600 env.sh` since it holds live credentials.
# Every wrapper (blog.sh, scripts/deploy-web.sh, scripts/refresh-sidebar.sh,
# scripts/publish-scheduled.sh) sources it before running.

# --- Site -------------------------------------------------------------

# Required for a live site: the canonical URL posts/RSS/sitemap/OG tags are
# built from. Overrides config/site.yml's site.base_url if both are set --
# this is the one value allowed to depend on the environment (e.g. a local
# or staging build pointing somewhere other than production).
export SITE_BASE_URL=https://example.com

# --- Comments network (matches the section in config/site.yml) --------

# Only needed if config/site.yml has a `mastodon:` section -- without a
# token, ./blog.sh still works, it just never posts a toot or fetches
# post stats. Create one on the target instance under Preferences ->
# Development -> New application, scope write:statuses.
export MASTODON_ACCESS_TOKEN=

# Only needed if config/site.yml has a `bluesky:` section instead (the
# two are exclusive). An APP password -- Settings -> App Passwords on
# Bluesky -- never the account password.
export BLUESKY_APP_PASSWORD=

# --- Deploy -----------------------------------------------------------

# Which target ./scripts/deploy-web.sh ships the build to -- see
# lib/deploy_backend.rb. Leave unset for surfer, the default.
#   surfer copies via Cloudron Surfer's Files API (the SURFER_* values below)
#   local  copies into a directory on this machine (one served by your
#          own nginx/Caddy, a mounted volume, ...)
#   rsync  any rsync destination, local or over SSH
#   git    force-pushes the build as a one-commit snapshot to a branch --
#          GitHub/GitLab/Codeberg Pages serve it (free hosting + HTTPS)
#   rclone any rclone remote: S3, R2, B2, WebDAV, ... (credentials live
#          in rclone's own config, set up via `rclone config`)
#   sftp   openssh's sftp in batch mode -- for hosts with neither rsync
#          nor git; the deploy manifest supplies the diff
# export DEPLOY_BACKEND=local

# surfer (the default). All three are required together for deploys to
# actually upload anything -- without them, uploads are skipped (logged,
# not an error), which is convenient for a local-only build. SURFER_URL
# is the Cloudron app's base URL (Files API lives at
# <SURFER_URL>/api/files/...); SURFER_REMOTE_DIR is the subdirectory
# posts get uploaded under (leave empty to upload at the app's root).
export SURFER_URL=
export SURFER_TOKEN=
export SURFER_REMOTE_DIR=

# The alternative backends, each configured by its own value(s):
# export DEPLOY_TARGET_DIR=/var/www/mysite          # local backend
# export RSYNC_TARGET=user@server:/var/www/mysite   # rsync backend
# export RSYNC_SSH="ssh -p 202"                     # rsync: optional ssh override
# export GIT_PAGES_REMOTE=git@github.com:you/site.git   # git backend
# export GIT_PAGES_BRANCH=gh-pages                  # git: optional, this is the default
# export GIT_PAGES_CNAME=www.example.com            # git: optional custom domain
# export RCLONE_TARGET=r2:my-bucket/site            # rclone backend
# export RCLONE_ARGS="--s3-acl public-read"         # rclone: optional extra flags
# export SFTP_TARGET=user@server                    # sftp backend
# export SFTP_REMOTE_DIR=/var/www/mysite            # sftp: optional remote directory
# export SFTP_ARGS="-P 2022"                        # sftp: optional extra flags

# --- Imports (unused in normal operation) -----------------------------
# Both ./import.sh (the wizard) and the scripts/migrate_*.rb equivalents
# read these.

# Needed to import a Tumblr blog -- the Tumblr API requires a key even for
# public blogs. Get one from https://www.tumblr.com/oauth/apps. Bluesky
# needs nothing here (it reads the public API) and the file-based imports
# read what you already downloaded.
export TUMBLR_API_KEY=

# Needed to import a LiveJournal journal -- LJ has no export file, so the
# import reads the account's own API. The password never travels in
# plaintext: every call sends only a challenge-response digest of it.
export LJ_PASSWORD=

# Caps how many posts any of the scripts/migrate_*.rb imports writes in one
# run -- the way to sample a large archive before committing hours to it. A
# later full run overwrites those posts in place rather than duplicating
# them. The wizard previews instead, so it ignores this. Unset = import
# everything.
# export LIMIT=50
