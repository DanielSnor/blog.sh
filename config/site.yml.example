# Site configuration -- everything about the site except its secrets,
# which live in env.sh (API tokens). Your own config/site.yml is
# gitignored, like env.sh: keep it with your backups, not in the engine's
# repository. Splitting it this way is what lets a local build render the
# same site as production.
#
# Copy this file to config/site.yml (gitignored -- see .gitignore) and fill
# it in for your own site. After every edit, rebuild: ./blog.sh rebuild, or
# directly ruby build/build_blog.rb && ./scripts/deploy-web.sh.
#
# A minimal config with just site and banner is a complete, working site.
# Everything else is optional, and a section left out -- or emptied --
# means the engine's own default -- never a broken page.
#
# HOW TO READ THE '#' LINES. This file uses them for two different jobs,
# and telling them apart is the one thing worth knowing before you edit:
#
#   # like this sentence      documentation. Prose, never a setting.
#   # layout:                 a SETTING that is switched off. Drop the
#   #   sidebar: true         '# ' from every line of the block to use it.
#   #   # instance: "..."     two '#': stays off even after you switch
#                             its block on -- an optional key inside an
#                             optional section.
#
# So one '#' in front of a key means "uncomment me", and two mean "still
# optional". Where a switched-off section ENDS is marked with its own
# '# --- end of ... ---' line, because once both are commented, a
# paragraph of prose and a block of settings look exactly alike -- and
# uncommenting half a section leaves the keys you did uncomment belonging
# to whatever section came before it, with no error to tell you so.
# ./blog.sh doctor reads the file you wrote and says what it found.
#
# EVERY SETTING THERE IS, in the order they appear below. A key shown in
# (brackets) is optional and commented out where it lives; the rest of
# this file explains each one where it stands.
#
#   site        title, short_name, description, author, lang, locale,
#               timezone, base_url, (page_size), (extra_css)
#   banner      src, alt, width, height, (show_title), (show_claim), (claim)
#   colors      light/dark: bg, text, meta_text, accent, nav_bg, border,
#               pill_bg, (banner_title), (banner_claim)
#   fonts       (faces), (banner_title), (banner_title_size),
#               (banner_claim), (banner_claim_size)
#   layout      (sidebar), (hero)
#   nav         (the menu bar: label with tag or url -- or [] for none)
#   about       heading, html
#   widgets     (toots, pixelfed, commits, bluesky, rss)
#   footer      links_heading, links, note_heading, note_html, copyright,
#               social_heading
#   social      name, url, icon or icon_svg, (rel)
#   tag_icons   (a list: tag with icon or icon_svg)
#   share       (the share block: a list of network names)
#   write       (the /write/ page: true to publish it, off by default)
#   mastodon    (instance), (toot_length)        -- OR bluesky, never both
#   bluesky     (handle), (pds)
#   comments    (approval)
#   publishing  (slots)
#   media       (convert_heic), (remux_video), (strip_location)
#   seo         (block_ai_crawlers), (robots_extra)
#   analytics   (src), (website_id)
#
# The order is the order the page reads, top to bottom -- identity, then
# the header, the palette and the type, then the regions, the menu, the
# sidebar, the footer, the marks beside the tags and the block a reader
# carries the post away from -- and after that the parts with no place on
# the page at all: the writing page, the comments network, publishing,
# media, robots, analytics.
# ./style.sh walks its own menu the same way.

site:
  # The full title -- <title> on the homepage, and the basis for every other page's.
  title: "Your Name - personal web/log"
  # Short name, used for og:site_name, listing titles ("Tag: foo -- YOURSITE"),
  # and as the banner overlay title (top-left, see .banner-title in site.css).
  short_name: "YOURSITE"
  # Also shown as the banner overlay claim (bottom-right, wraps to multiple
  # lines if needed -- see .banner-claim in site.css) UNLESS banner.claim
  # below is set. This value stays plain text on purpose -- it's reused
  # verbatim in <meta name="description">, the RSS <description> and
  # listing-page descriptions, none of which should ever see raw HTML.
  description: "Personal web/log of Your Name"
  author: "Your Name"
  # Selects locales/<lang>.yml (see lib/i18n.rb). "en", "cs" and "de" ship with the
  # engine; add another locales/<code>.yml to support a different language --
  # any key missing from it falls back to English.
  lang: "en"
  locale: "en_US"
  # The timezone every timestamp this engine writes is expressed in: publish
  # times, "publish now", the date you type into `schedule`. An IANA zone
  # name (see /usr/share/zoneinfo) -- DST is handled for you.
  #
  # Set this whenever the machine's clock isn't in the zone you think in:
  # a server is very often UTC, so without it "schedule 10:30" means 10:30
  # UTC, and a post written after midnight local time can even be dated to
  # the previous day. Omit it to keep using the machine's own zone.
  # Existing posts are unaffected -- each keeps the offset it was written
  # with, so changing this doesn't rewrite history.
  timezone: "Europe/Prague"
  # Overridden by the SITE_BASE_URL environment variable, if set.
  base_url: "https://example.com"
  # Optional: posts per listing page (default 10). Set it ONCE, before
  # the first deploy -- pagination is anchored so page contents never
  # change, and changing this later renumbers every existing page.
  # page_size: 10
  # Optional: stylesheets loaded after the engine's own, in this order --
  # where a skin belongs, so that dressing the site differently never
  # means editing a template and losing the edit to the next git pull.
  # Drop the file into assets/css/ and name it here.
  #
  # Paths on this site only. Every page carries style-src 'self', so a
  # stylesheet on another host (a CDN, Google Fonts) is discarded by the
  # browser with no error anywhere you would see one -- the site simply
  # renders undressed. The build says which line it skipped, and
  # ./blog.sh doctor reports both that and a local path that isn't there.
  # extra_css:
  #   - "/assets/css/skin.css"

banner:
  # Ships with the engine, so a fresh install renders before you've drawn
  # anything -- replace it with your own image and update the size below.
  src: "/assets/images/header.png"
  alt: "Your Site"
  # The file's actual dimensions -- reserves space before the image loads.
  # The shipped banner is twice its display size so it stays sharp on a
  # dense screen; .banner is width:100% in the stylesheet, so what these two
  # numbers do is hold the ASPECT RATIO open while the image arrives. Put
  # your own image's real dimensions here -- doctor compares them with the
  # file and says so when they drift apart.
  width: 1880
  height: 600
  # Optional, independent of each other (default true for both): whether
  # site.short_name / site.description render as text overlaid on the
  # banner image. Turn either off if the image is busy enough on its own.
  # show_title: true
  # show_claim: true
  # Optional: overrides ONLY the banner overlay's claim text -- everywhere
  # else (meta description, RSS, listing pages) keeps using site.description
  # unchanged. Exists because site.description must stay plain text (see
  # above), so it can't carry a manual line break; this field can, since
  # nothing but the banner overlay ever reads it. Markdown, and HTML just
  # as before -- same trust level as about.html/footer.note_html below
  # (site.yml is owner-edited config, not visitor input).
  # claim: "First line<br>Second line"

# Optional. Omit this whole section (or any key inside it) to fall back to
# blog.sh's own blue palette (DEFAULT_COLORS in lib/colors_css.rb). Each
# mode only takes these 7 keys -- everything else the CSS needs (card
# background, nav text/border, link/badge hover, search input background)
# is derived from them at build time (see color_properties in
# lib/colors_css.rb), not separately configurable, since it's never
# varied independently across any palette this engine has shipped.
# Ready-made palettes live in config/palettes.yml -- `./style.sh` lists
# them, shows a preview, and writes the chosen one in here, which beats
# picking fourteen hex values by hand. Adding your own to that file makes
# it appear in the list.
# Rebuild after changing any value here: ./blog.sh rebuild.
#
# banner_title / banner_claim are the one exception: two more OPTIONAL
# keys per mode, independent of each other and of the 7 above, for the
# banner overlay text's color (see banner.show_title/show_claim above).
# Default when omitted: nav_bg in light mode, white in dark mode -- the
# same look the banner had before these keys existed.
colors:
  light:
    bg: "#f5f8fa"
    text: "#444a5a"
    meta_text: "#657784"
    accent: "#1da1f2"
    nav_bg: "#eaf5fd"
    border: "#e1e8ed"
    pill_bg: "#d6ecfc"
    # banner_title: "#ffffff"
    # banner_claim: "#ffffff"
  dark:
    bg: "#111111"
    text: "#ffffff"
    meta_text: "#6a7f8c"
    accent: "#4ab3f4"
    nav_bg: "#192734"
    border: "#263340"
    pill_bg: "#16324a"
    # banner_title: "#ffffff"
    # banner_claim: "#ffffff"

# Optional, and the typographic half of the palette: the two lines painted
# over the banner -- the site's name and its claim -- take their font AND
# size from here. Omit the section (or any key in it) and they stay in the
# engine's own monospace at 45px/20px, exactly as before these keys
# existed. The rest of the site's typography is not configurable; this is
# the header, not a theming system.
# Rebuild after changing anything here: ./blog.sh rebuild.
#
# The *_size keys matter as much as the families: a serif set at the
# monospace default's 45px fills the banner quite differently, so the pair
# belongs together. Any CSS length works (px, rem, even clamp()), and the
# narrow-screen sizes follow automatically -- site.css scales them from
# these, so a phone still steps down instead of overflowing.
#
# Each family key is a CSS font stack, used as written, so system families
# need nothing else: banner_title: '"Iowan Old Style", Palatino, Georgia,
# serif' is a complete answer. Title and claim are independent -- a serif
# name above a sans-serif claim is one line each.
#
# To use your OWN font, drop the file into assets/fonts/ and declare it
# under `faces` first; then name it in the stack. Only the file name is
# used (no paths), the format follows the extension (.woff2, .woff, .ttf,
# .otf), `weight` and `style` are optional ("400 700" and normal). A file
# declared here but missing from assets/fonts/ is named in the build
# output and skipped -- the site would otherwise render in the fallback
# and look like the config simply didn't work.
# fonts:
#   faces:
#     - family: "Playfair Display"
#       file: "playfair-display.woff2"
#       weight: "400 700"
#   banner_title: '"Playfair Display", Georgia, serif'
#   banner_title_size: "52px"
#   banner_claim: '"Open Sans", Arial, Helvetica, sans-serif'
#   banner_claim_size: "20px"
# --- end of fonts ---

# Optional. Which structural regions of the page exist at all. Every key
# defaults to the layout the engine has always had, so omitting the whole
# section changes nothing.
#
# These are switches for whole regions, not for how a region looks: what
# it looks like belongs in a stylesheet (site.extra_css above). A key per
# visual property would turn this file into a stylesheet written in YAML.
# layout:
#   # The right-hand column: about, widgets, per-post stats. With it off
#   # the content takes the full width instead of leaving a gap where the
#   # sidebar was. Default: true.
#   sidebar: true
#   # Lift a post's first usable image out of the text and show it above
#   # the title, with the byline under it. Off by default because it
#   # reshapes every post page. A single post overrides the site either
#   # way with a `hero:` line in its own file: `hero: false` keeps the
#   # photo where it was written, `hero: true` asks for one on a site
#   # that doesn't use them. A post with no usable image (or only a 1x1
#   # tracking pixel out of an old import) keeps the ordinary layout.
#   hero: false
# --- end of layout ---

# Optional. The menu across the top. Without this key the menu is what the
# engine derives: All, then one entry per content type the site actually
# has, growing as the archive does.
#
# With it, the site names its own entries instead -- `tag:` is a tag's
# slug and becomes its listing, `url:` is taken as written, so an entry
# can point at a post, at /markdown/, or off the site entirely. Useful
# when the site's subjects are a better map of it than its media types.
#
# An empty list (nav: []) is an answer too: the entries and the button
# that opens them are gone. That is how a site turns the menu off -- there
# is no second key for it. The bar itself stays, because the search field
# is rendered inside it. A bare `nav:` with nothing under it means the same
# thing; delete the key itself to get the engine's own menu back.
#
# `./style.sh` writes this for you and offers the tags and pages you
# actually have; `./blog.sh doctor` says so when an entry stops pointing
# at anything, which is what happens to a menu written a year ago.
# nav:
#   - { label: "Home", url: "/" }
#   - { label: "Photography", tag: "photography" }
#   - { label: "Syntax", url: "/markdown/" }
# --- end of nav ---

# The sidebar's introduction card. Nothing here is load-bearing: an
# emptied html takes the card with it, heading and all, and deleting
# the whole block reads the same as emptying it.
about:
  heading: "About"
  # Markdown, the same as in a post: **bold**, [links](https://example.com),
  # lists, a blank line for a new paragraph. Raw HTML still works too and is
  # how a photo gets in (<img>) -- Markdown images are left out on purpose,
  # since they resolve filenames against a post's media directory and the
  # sidebar has none.
  # The '|-' matters: in a folded scalar ('>-') YAML turns a blank line into
  # a single newline, which reads as one wrapped paragraph rather than two --
  # and glues the items of a list together. Here every line stays as typed,
  # and wrapped prose still collapses back into one paragraph when rendered.
  html: |-
    A short bio about yourself, with a [link](https://example.com)
    if you like.

# Optional, and each entry independently so. Sidebar widget data is fetched
# by the server (lib/sidebar.rb), not the visitor's browser, and refreshed
# by cron via ./scripts/refresh-sidebar.sh. Commented out here because the
# placeholder accounts don't exist -- uncomment an entry once you've put
# your own values in; omitting any entry (or the whole `widgets:` key)
# just means no such widget.
# widgets:
#   toots:
#     heading: "Recent toots"
#     # instance is optional -- it falls back to mastodon.instance below,
#     # so set it only when the widget shows an account living elsewhere.
#     # instance: "mastodon.social"
#     account_id: "000000000000000000" # the account's API id, not the @handle -- a number on Mastodon, a ULID on GoToSocial
#     limit: 3
#   pixelfed:
#     heading: "Recent Pixelfed posts"
#     feed_url: "https://pixelfed.social/users/yourname.atom"
#     limit: 3
#   commits:
#     heading: "Recent commits"
#     username: "yourname"
#     limit: 3
#     # GitHub unless you say otherwise. For a Gitea or Forgejo server --
#     # Codeberg, your own git -- give its address here and the widget
#     # reads that instead; the address is the whole configuration.
#     # instance: "https://codeberg.org"
#   bluesky:
#     heading: "Recent Bluesky posts"
#     # handle is optional -- it falls back to bluesky.handle below, so set
#     # it only when the widget shows an account other than the site's own.
#     # handle: "you.bsky.social"
#     limit: 3
#   rss:
#     heading: "Elsewhere"
#     # Any RSS 2.0 or Atom feed: another blog, a YouTube channel, a
#     # podcast -- or X through a self-hosted Nitter instance.
#     feed_url: "https://example.com/feed.xml"
#     limit: 3
# --- end of widgets ---

# Three columns: links, a note with the copyright line, social icons.
# Each heading rides with its content -- empty the links (links: [] is
# an answer, like nav) and the Links column renders nothing, heading
# included, rather than a title over an empty list. Same for the note,
# the copyright and the icons; a deleted block reads as all-empty.
footer:
  links_heading: "Links"
  links:
    - title: "Example"
      url: "https://example.com"
  note_heading: "Found something here?"
  # Markdown as well (see about.html above for what '|-' is doing here);
  # more than one paragraph is fine.
  note_html: |-
    If an article or photo here caught your eye and you'd like to use it
    elsewhere, let me know -- happy to work something out. Please don't
    just copy-paste my content elsewhere without asking!
  # Markdown too, on one line -- and HTML entities keep working, so the
  # '&copy;' below still renders as a copyright sign and needs no migrating.
  # (This file stays ASCII on purpose: ConfigWriter reads it under whatever
  # default_external the caller has, which under cron or the system Ruby is
  # US-ASCII -- one accented character here and both wizards stop working.)
  copyright: "All rights reserved &copy; 2026"
  social_heading: "Find me on"

# icon = a name from the built-in set. The network marks: mastodon,
# pixelfed, linkedin, github, gitea, forgejo, codeberg, gitlab, bluesky,
# instagram, threads, facebook, x, youtube, rss, email. Or any of the
# general drawings the engine ships for tag_icons -- `globe` for somebody's
# other site, `mail` for a newsletter (the tag_icons block below lists
# them). A name it does not know draws nothing at all -- a link with an
# empty space where the icon should be -- so `./blog.sh doctor` says when
# it finds one, and names what it does have.
# For another network, use icon_svg with your own <svg>...</svg> instead.
#
# rel = an optional rel attribute for the rendered link. rel: "me" is
# what earns the green check mark next to your site on a Mastodon profile:
# Mastodon fetches the address you put in a profile metadata field and
# verifies it only if that page links back with rel="me" to the profile.
# Since the icons sit in the footer, every page carries the link -- put
# your home page in the profile field and it just works. The url: here
# has to be your profile as Mastodon shows it (https://instance/@handle).
# More than one entry may carry rel: "me".
social:
  - name: "Mastodon"
    url: "https://mastodon.social/@yourname"
    icon: "mastodon"
    rel: "me"
  - name: "Bluesky"
    url: "https://bsky.app/profile/yourname.bsky.social"
    icon: "bluesky"
  - name: "GitHub"
    url: "https://github.com/yourname"
    icon: "github"
  - name: "E-mail"
    url: "mailto:you@example.com"
    icon: "email"

# Icons for tags. A tag named here carries its icon in two places: the
# heading of its own /tag/<name>/ listing, and the date badge of every post
# that has it -- where it REPLACES the content-type icon rather than
# joining it. A badge is a small tile with a date and one glyph; the only
# thing that ever adds a second is a pinned post, and that stays the
# exception.
#
# A LIST, because the order is the priority: most posts carry more than one
# tag, and the tag a post was given first is usually the one an importer
# added. The first entry here that a post has is the one it wears.
#
# `icon` names one the engine ships. Eight are the content types -- text,
# quote, chat, image, video, audio, link, document -- and about fifty more
# are the things blogs are about: bike, car, train, plane, boat, walk, map,
# pin, mountain, tree, sun, cloud, rain, snow, coffee, beer, food, wine,
# clock, calendar, home, heart, star, gift, pen, brush, camera, film, mic,
# music, book, tools, hammer, laptop, phone, code, terminal, server, bug,
# lock, key, paw, bird, leaf, flower, bulb, flag, globe, eye, chart,
# target, rocket, mail, briefcase, box. `doctor` prints the list when a
# name is not among them. `icon_svg` is your own -- drawn on the same
# 24-unit grid (`viewBox="0 0 24 24"`) and stroked in `currentColor`, or it
# will not follow the light and dark themes. Scripts, styles and event
# handlers are stripped from it before it reaches a page.
#
# tag_icons:
#   - tag: "fotografie"
#     icon: "image"
#   - tag: "kolo"
#     icon_svg: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="17" r="4"/><circle cx="18" cy="17" r="4"/><path d="M6 17l4-9h5l3 9"/></svg>'
# --- end of tag_icons ---

# WHERE A READER CAN CARRY A POST AWAY TO. A list of network names; leave
# it out and no block appears. What gets prefilled is the post's name and
# its address -- the reader writes the part that is theirs.
#
# The names: mastodon, bluesky, email, facebook, linkedin, threads, x --
# plain links, one address each -- plus copy, which puts the address on the
# clipboard, and system, which hands the post to the operating system's own
# share sheet (on a phone that is Signal and WhatsApp and Telegram at once).
#
# `mastodon` asks the reader once which instance they are on and remembers
# it in their own browser; there is no way for a page to know it, and the
# alternative is sending every reader through somebody else's redirector.
# Those three -- mastodon, copy and system -- need the browser to
# co-operate and are not drawn where it will not: copy needs https, system
# needs a share sheet. A block left with nothing it can draw hides itself.
#
# Pixelfed is not on the list: it has no share address to send anyone to,
# and a post there wants a photograph rather than a link.
#
# share:
#   - mastodon
#   - bluesky
#   - email
# --- end of share ---

# A page at /write/ to write a post on a phone: a title, the text, tags
# and photographs, and a button that hands the lot to an iOS shortcut,
# which carries it over SSH to scripts/receive.sh. Nothing new listens on
# the network and the page holds no secret -- sending needs the key that
# lives in the shortcut, on the phone.
#
# Off by default. It is a page for whoever runs the blog, and a site that
# writes from a desk has no use for it. Turning it on publishes five files
# under /write/ and nothing else changes; the page is marked noindex.
#
# Setting it up is in docs/operations.md, under "A post sent from the
# phone itself" -- the key, the forced command, and the shortcut.
#
# write: true
# --- end of write ---

# Optional. The comments/announcement network: every published post is
# announced there, and replies to that announcement are the post's
# comments. Uncomment EITHER mastodon: OR bluesky: -- never both; the
# build refuses a config with two networks, since comments live in
# exactly one place. Both stay off for a site with no network
# integration at all (no announcements, no comments, no post stats) --
# and off is how this ships, on purpose: a network named here means
# every publish tries to announce, and on a site that never chose one
# the attempt fails loudly on every scheduled run. This section used to
# ship filled in, and a hand-configured install got cron failure mail
# for it.
#
# The secrets go in env.sh, not here: MASTODON_ACCESS_TOKEN for
# Mastodon, BLUESKY_APP_PASSWORD for Bluesky. Uncomment the header line
# included -- that is the half that is easy to miss:
# mastodon:
#   instance: "mastodon.social"
#   # Optional: your instance's status character limit (default 500).
#   # Instances routinely raise it -- the auto-toot's excerpt grows to fit.
#   # toot_length: 500
#   # Optional: what your server charges for a link, whatever the link
#   # measures. Mastodon reserves 23 characters for every one of them and
#   # says so in its own API (characters_reserved_per_url); set this only
#   # if your server answers with something else.
#   # link_length: 23
# --- end of mastodon ---

# The Bluesky alternative, same shape:
# bluesky:
#   handle: "you.bsky.social"
#   # pds: "https://bsky.social"   # only for a self-hosted PDS
# --- end of bluesky ---

# Optional. Which replies are published under the article.
#
#   off   (default) all of them, read live from the network by the
#         visitor's browser -- what every site did before this existed.
#   fav   only the ones you favourite. You star a reply from whatever
#         Mastodon or Bluesky client you already use, and it appears at
#         the next cron run; everything else stays on the network and
#         off the blog. Your own replies are published without starring.
#
# What "fav" costs, plainly:
#   * It needs scripts/refresh-sidebar.sh in cron. "Did *I* favourite
#     this" is a question only an authenticated request can ask, so the
#     comments are prepared server-side and served from your own domain
#     rather than fetched by the visitor. Without that cron nothing new
#     ever appears. (The upside of the same change: the visitor's
#     browser stops talking to the network entirely.)
#   * On Mastodon the token in env.sh needs read:statuses as well as
#     write:statuses. Reissue it if it predates this.
#   * Approving is not instant -- up to one cron interval, and for a
#     post older than ~90 days up to a week unless you run
#     ./scripts/refresh-sidebar.sh --full.
#   * A favourite is public on both networks. Anyone can see which
#     replies you starred, and every reply you have ever starred out of
#     politeness counts as approved.
#   * Turning this on hides every existing comment until you go and star
#     the ones you want kept.
#   * It keeps replies off your blog. It cannot remove them from the
#     network, where the thread stays public -- for that you still have
#     block, mute and report.
#
# comments:
#   approval: fav
# --- end of comments ---

# Optional. The times posts usually go out. With this set, [s] in the
# draft dialog offers the next FREE slot instead of an empty prompt, so
# three drafts written in one evening go out on three consecutive slots
# rather than all at once. Typing a date always overrides the offer, and
# a slot never moves a post that is already scheduled. Format is
# "<day> HH:MM" (mon/tue/.../sun, or daily); omit the key entirely and
# scheduling behaves exactly as before.
# publishing:
#   slots:
#     - "mon 09:30"
#     - "wed 09:30"
#     - "fri 09:30"
# --- end of publishing ---

# Optional. HEIC photos (the iPhone default) display only in Safari --
# every other browser shows a broken image. Off (the default), attaching
# one stops the save and prints the exact conversion command; nothing is
# lost. On, the engine converts it to JPEG itself by shelling out to an
# image tool the machine already has (sips on macOS; heif-convert,
# ImageMagick or vips on Linux) -- and refuses the file if none is found.
# This is the engine's only optional external tool besides the deploy
# backends; nothing else changes.
#
# strip_location is ON without being set, and this is the line that turns it
# off. A phone writes the spot it stood on into every photo it takes, and
# this engine copies media byte for byte, so a picture from a back garden
# published the back garden. Only the location goes: the camera, the lens and
# the moment the shutter opened stay, and so does the Orientation tag, which
# is what keeps a portrait photo standing up. Set it to false if you want the
# coordinates kept -- a walking diary or a photo blog reasonably does.
# Photos already in the archive are not touched by the upgrade. `./blog.sh
# doctor` counts the ones that still carry a location -- in media.nosync and
# in assets/, where the sidebar's own picture lives -- and `./blog.sh doctor
# --strip-location` cleans them. Rebuild afterwards: the site is made from
# those two directories, so that is what carries the change onto it.
# remux_video moves a video's index to the front of the file and out of the
# QuickTime container, by copying the picture and the sound across untouched
# -- a repack, not a re-encode, so it takes a second and changes nothing you
# can see. A recorder has to write that index last, which makes a reader wait
# for the whole file before the first frame appears; some browsers decline
# .mov on the container alone. Off, the engine says so and names the command,
# as it always has. On, it needs ffmpeg, and if the repack fails or ffmpeg is
# missing the post is still saved -- unlike a HEIC photo, a video in the wrong
# wrapper still plays for nearly everybody.
# media:
#   convert_heic: true
#   remux_video: true
#   strip_location: false
# --- end of media ---

# Optional. What robots.txt says beyond "everything is allowed".
#
# block_ai_crawlers writes out a maintained list of the crawlers that
# collect text to train on (GPTBot, ClaudeBot, CCBot, Google-Extended,
# PerplexityBot and friends). Off by default: wanting to be findable in an
# answer somebody gets from a machine is a legitimate position, and the
# engine does not take it on your behalf either way.
#
# It is a REQUEST, not a fence. Some of these honour robots.txt and some
# do not, and nothing here can make them -- if that matters to you, the
# answer is at the web server, not in this file.
#
# robots_extra is appended verbatim, for the agents no list will ever be
# current about.
# seo:
#   block_ai_crawlers: false
#   robots_extra: |
#     User-agent: SomeOtherBot
#     Disallow: /
# --- end of seo ---

# Optional. Omit this whole section for a site with no analytics script.
# Commented out so a fresh build doesn't reference a script that isn't
# yours -- uncomment with your own values.
# analytics:
#   src: "https://analytics.example.com/script.js"
#   website_id: "00000000-0000-0000-0000-000000000000"
# --- end of analytics ---
