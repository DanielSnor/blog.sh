# Site configuration -- everything about the site except its secrets,
# which live in env.sh (API tokens). Your own config/site.yml is
# gitignored, like env.sh: keep it with your backups, not in the engine's
# repository. Splitting it this way is what lets a local build render the
# same site as production.
#
# Copy this file to config/site.yml (gitignored -- see .gitignore) and fill
# it in for your own site. After every edit, rebuild: ./blog.sh rebuild, or
# directly ruby build/build_blog.rb && ./scripts/deploy-web.sh.
#
# Sections in the order the page reads, top to bottom (the same order
# ./style.sh's menu walks them): identity (site) -> the whole page's
# palette (colors) -> the header (banner, fonts) -> the sidebar (about,
# widgets) -> the footer (footer, social) -> analytics -> then the parts
# with no place on the page: the comments network (mastodon OR bluesky),
# publishing slots, media habits. A minimal config with just site,
# banner, about and footer is a complete, working site.

site:
  # The full title -- <title> on the homepage, and the basis for every other page's.
  title: "Your Name - personal web/log"
  # Short name, used for og:site_name, listing titles ("Tag: foo -- YOURSITE"),
  # and as the banner overlay title (top-left, see .banner-title in site.css).
  short_name: "YOURSITE"
  # Also shown as the banner overlay claim (bottom-right, wraps to multiple
  # lines if needed -- see .banner-claim in site.css) UNLESS banner.claim
  # below is set. This value stays plain text on purpose -- it's reused
  # verbatim in <meta name="description">, the RSS <description> and
  # listing-page descriptions, none of which should ever see raw HTML.
  description: "Personal web/log of Your Name"
  author: "Your Name"
  # Selects locales/<lang>.yml (see lib/i18n.rb). "en", "cs" and "de" ship with the
  # engine; add another locales/<code>.yml to support a different language --
  # any key missing from it falls back to English.
  lang: "en"
  locale: "en_US"
  # The timezone every timestamp this engine writes is expressed in: publish
  # times, "publish now", the date you type into `schedule`. An IANA zone
  # name (see /usr/share/zoneinfo) -- DST is handled for you.
  #
  # Set this whenever the machine's clock isn't in the zone you think in:
  # a server is very often UTC, so without it "schedule 10:30" means 10:30
  # UTC, and a post written after midnight local time can even be dated to
  # the previous day. Omit it to keep using the machine's own zone.
  # Existing posts are unaffected -- each keeps the offset it was written
  # with, so changing this doesn't rewrite history.
  timezone: "Europe/Prague"
  # Overridden by the SITE_BASE_URL environment variable, if set.
  base_url: "https://example.com"
  # Optional: posts per listing page (default 10). Set it ONCE, before
  # the first deploy -- pagination is anchored so page contents never
  # change, and changing this later renumbers every existing page.
  # page_size: 10

# Optional. Omit this whole section (or any key inside it) to fall back to
# blog.sh's own blue palette (DEFAULT_COLORS in lib/colors_css.rb). Each
# mode only takes these 7 keys -- everything else the CSS needs (card
# background, nav text/border, link/badge hover, search input background)
# is derived from them at build time (see color_properties in
# lib/colors_css.rb), not separately configurable, since it's never
# varied independently across any palette this engine has shipped.
# Ready-made palettes live in config/palettes.yml -- `./style.sh` lists
# them, shows a preview, and writes the chosen one in here, which beats
# picking fourteen hex values by hand. Adding your own to that file makes
# it appear in the list.
# Rebuild after changing any value here: ./blog.sh rebuild.
#
# banner_title / banner_claim are the one exception: two more OPTIONAL
# keys per mode, independent of each other and of the 7 above, for the
# banner overlay text's color (see banner.show_title/show_claim below).
# Default when omitted: nav_bg in light mode, white in dark mode -- the
# same look the banner had before these keys existed.
colors:
  light:
    bg: "#f5f8fa"
    text: "#444a5a"
    meta_text: "#657784"
    accent: "#1da1f2"
    nav_bg: "#eaf5fd"
    border: "#e1e8ed"
    pill_bg: "#d6ecfc"
    # banner_title: "#ffffff"
    # banner_claim: "#ffffff"
  dark:
    bg: "#111111"
    text: "#ffffff"
    meta_text: "#6a7f8c"
    accent: "#4ab3f4"
    nav_bg: "#192734"
    border: "#263340"
    pill_bg: "#16324a"
    # banner_title: "#ffffff"
    # banner_claim: "#ffffff"

banner:
  # Ships with the engine, so a fresh install renders before you've drawn
  # anything -- replace it with your own image and update the size below.
  src: "/assets/images/header.png"
  alt: "Your Site"
  # The file's actual dimensions -- reserves space before the image loads.
  width: 940
  height: 300
  # Optional, independent of each other (default true for both): whether
  # site.short_name / site.description render as text overlaid on the
  # banner image. Turn either off if the image is busy enough on its own.
  # show_title: true
  # show_claim: true
  # Optional: overrides ONLY the banner overlay's claim text -- everywhere
  # else (meta description, RSS, listing pages) keeps using site.description
  # unchanged. Exists because site.description must stay plain text (see
  # above), so it can't carry a manual line break; this field can, since
  # nothing but the banner overlay ever reads it. Markdown, and HTML just
  # as before -- same trust level as about.html/footer.note_html below
  # (site.yml is owner-edited config, not visitor input).
  # claim: "First line<br>Second line"

# Optional, and the typographic half of the palette: the two lines painted
# over the banner -- the site's name and its claim -- take their font AND
# size from here. Omit the section (or any key in it) and they stay in the
# engine's own monospace at 45px/20px, exactly as before these keys
# existed. The rest of the site's typography is not configurable; this is
# the header, not a theming system.
# Rebuild after changing anything here: ./blog.sh rebuild.
#
# The *_size keys matter as much as the families: a serif set at the
# monospace default's 45px fills the banner quite differently, so the pair
# belongs together. Any CSS length works (px, rem, even clamp()), and the
# narrow-screen sizes follow automatically -- site.css scales them from
# these, so a phone still steps down instead of overflowing.
#
# Each family key is a CSS font stack, used as written, so system families
# need nothing else: banner_title: '"Iowan Old Style", Palatino, Georgia,
# serif' is a complete answer. Title and claim are independent -- a serif
# name above a sans-serif claim is one line each.
#
# To use your OWN font, drop the file into assets/fonts/ and declare it
# under `faces` first; then name it in the stack. Only the file name is
# used (no paths), the format follows the extension (.woff2, .woff, .ttf,
# .otf), `weight` and `style` are optional ("400 700" and normal). A file
# declared here but missing from assets/fonts/ is named in the build
# output and skipped -- the site would otherwise render in the fallback
# and look like the config simply didn't work.
# fonts:
#   faces:
#     - family: "Playfair Display"
#       file: "playfair-display.woff2"
#       weight: "400 700"
#   banner_title: '"Playfair Display", Georgia, serif'
#   banner_title_size: "52px"
#   banner_claim: '"Open Sans", Arial, Helvetica, sans-serif'
#   banner_claim_size: "20px"

about:
  heading: "About"
  # Markdown, the same as in a post: **bold**, [links](https://example.com),
  # lists, a blank line for a new paragraph. Raw HTML still works too and is
  # how a photo gets in (<img>) -- Markdown images are left out on purpose,
  # since they resolve filenames against a post's media directory and the
  # sidebar has none.
  # The '|-' matters: in a folded scalar ('>-') YAML turns a blank line into
  # a single newline, which reads as one wrapped paragraph rather than two --
  # and glues the items of a list together. Here every line stays as typed,
  # and wrapped prose still collapses back into one paragraph when rendered.
  html: |-
    A short bio about yourself, with a [link](https://example.com)
    if you like.

# Optional, and each entry independently so. Sidebar widget data is fetched
# by the server (lib/sidebar.rb), not the visitor's browser, and refreshed
# by cron via ./scripts/refresh-sidebar.sh. Commented out here because the
# placeholder accounts don't exist -- uncomment an entry once you've put
# your own values in; omitting any entry (or the whole `widgets:` key)
# just means no such widget.
# widgets:
#   toots:
#     heading: "Recent toots"
#     # instance is optional -- it falls back to mastodon.instance below,
#     # so set it only when the widget shows an account living elsewhere.
#     # instance: "mastodon.social"
#     account_id: "000000000000000000" # numeric Mastodon account id, not the @handle
#     limit: 3
#   pixelfed:
#     heading: "Recent Pixelfed posts"
#     feed_url: "https://pixelfed.social/users/yourname.atom"
#     limit: 3
#   commits:
#     heading: "Recent commits"
#     username: "yourname"
#     limit: 3
#   bluesky:
#     heading: "Recent Bluesky posts"
#     # handle is optional -- it falls back to bluesky.handle below, so set
#     # it only when the widget shows an account other than the site's own.
#     # handle: "you.bsky.social"
#     limit: 3
#   rss:
#     heading: "Elsewhere"
#     # Any RSS 2.0 or Atom feed: another blog, a YouTube channel, a
#     # podcast -- or X through a self-hosted Nitter instance.
#     feed_url: "https://example.com/feed.xml"
#     limit: 3

footer:
  links_heading: "Links"
  links:
    - title: "Example"
      url: "https://example.com"
  note_heading: "Found something here?"
  # Markdown as well (see about.html above for what '|-' is doing here);
  # more than one paragraph is fine.
  note_html: |-
    If an article or photo here caught your eye and you'd like to use it
    elsewhere, let me know -- happy to work something out. Please don't
    just copy-paste my content elsewhere without asking!
  # Markdown too, on one line -- and HTML entities keep working, so the
  # '&copy;' below still renders as a copyright sign and needs no migrating.
  # (This file stays ASCII on purpose: ConfigWriter reads it under whatever
  # default_external the caller has, which under cron or the system Ruby is
  # US-ASCII -- one accented character here and both wizards stop working.)
  copyright: "All rights reserved &copy; 2026"
  social_heading: "Find me on"

# icon = a name from the built-in set: mastodon, pixelfed, linkedin,
# github, bluesky, instagram, threads, facebook, x, youtube, rss, email.
# For another network, use icon_svg with your own <svg>...</svg> instead.
#
# rel = an optional rel attribute for the rendered link. rel: "me" is
# what earns the green check mark next to your site on a Mastodon
# profile: Mastodon fetches the address you put in a profile metadata
# field and verifies it only if that page links back with rel="me" to
# the profile. Since the icons sit in the footer, every page carries the
# link -- put your home page in the profile field and it just works. The
# url: here has to be your profile as Mastodon shows it
# (https://instance/@handle). More than one entry may carry rel: "me".
social:
  - name: "Mastodon"
    url: "https://mastodon.social/@yourname"
    icon: "mastodon"
    rel: "me"
  - name: "Bluesky"
    url: "https://bsky.app/profile/yourname.bsky.social"
    icon: "bluesky"
  - name: "GitHub"
    url: "https://github.com/yourname"
    icon: "github"
  - name: "E-mail"
    url: "mailto:you@example.com"
    icon: "email"

# Optional. Omit this whole section for a site with no analytics script.
# Commented out so a fresh build doesn't reference a script that isn't
# yours -- uncomment with your own values.
# analytics:
#   src: "https://analytics.example.com/script.js"
#   website_id: "00000000-0000-0000-0000-000000000000"

# Optional. The comments/announcement network: every published post is
# announced there, and replies to that announcement are the post's
# comments. Configure EITHER mastodon: OR bluesky: -- never both; the
# build refuses a config with two networks, since comments live in
# exactly one place. Omit both sections for a site with no network
# integration at all (no announcements, no comments, no post stats).
#
# The secrets go in env.sh, not here: MASTODON_ACCESS_TOKEN for
# Mastodon, BLUESKY_APP_PASSWORD for Bluesky.
mastodon:
  instance: "mastodon.social"
  # Optional: your instance's status character limit (default 500).
  # Instances routinely raise it -- the auto-toot's excerpt grows to fit.
  # toot_length: 500

# The Bluesky alternative (uncomment this and remove mastodon: above):
# bluesky:
#   handle: "you.bsky.social"
#   # pds: "https://bsky.social"   # only for a self-hosted PDS

# Optional. The times posts usually go out. With this set, [s] in the
# draft dialog offers the next FREE slot instead of an empty prompt, so
# three drafts written in one evening go out on three consecutive slots
# rather than all at once. Typing a date always overrides the offer, and
# a slot never moves a post that is already scheduled. Format is
# "<day> HH:MM" (mon/tue/.../sun, or daily); omit the key entirely and
# scheduling behaves exactly as before.
# publishing:
#   slots:
#     - "mon 09:30"
#     - "wed 09:30"
#     - "fri 09:30"

# Optional. HEIC photos (the iPhone default) display only in Safari --
# every other browser shows a broken image. Off (the default), attaching
# one stops the save and prints the exact conversion command; nothing is
# lost. On, the engine converts it to JPEG itself by shelling out to an
# image tool the machine already has (sips on macOS; heif-convert,
# ImageMagick or vips on Linux) -- and refuses the file if none is found.
# This is the engine's only optional external tool besides the deploy
# backends; nothing else changes.
#
# strip_location is ON without being set, and this is the line that turns it
# off. A phone writes the spot it stood on into every photo it takes, and
# this engine copies media byte for byte, so a picture from a back garden
# published the back garden. Only the location goes: the camera, the lens and
# the moment the shutter opened stay, and so does the Orientation tag, which
# is what keeps a portrait photo standing up. Set it to false if you want the
# coordinates kept -- a walking diary or a photo blog reasonably does.
# Photos already in the archive are not touched by the upgrade. `./blog.sh
# doctor` counts the ones that still carry a location -- in media.nosync and
# in assets/, where the sidebar's own picture lives -- and `./blog.sh doctor
# --strip-location` cleans them. Rebuild afterwards: the site is made from
# those two directories, so that is what carries the change onto it.
# media:
#   convert_heic: true
#   strip_location: false
