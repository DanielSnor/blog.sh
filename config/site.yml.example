# Site configuration. Versioned and synced to the server -- unlike env.sh,
# which only holds secrets (API tokens). If these values lived in env.sh
# instead, a local build would render a different site than production, and
# changes would have no history.
#
# Copy this file to config/site.yml (gitignored -- see .gitignore) and fill
# it in for your own site. After every edit, rebuild: ./blog.sh rebuild, or
# directly ruby build/build_blog.rb && ./scripts/deploy-web.sh.
#
# Sections in reading order: identity (site, banner, about, footer,
# social) -> the comments network (mastodon OR bluesky) -> optional
# extras (widgets, analytics, colors). A minimal config with just site,
# banner, about and footer is a complete, working site.

site:
  # The full title -- <title> on the homepage, and the basis for every other page's.
  title: "Your Name - personal web/log"
  # Short name, used for og:site_name, listing titles ("Tag: foo -- YOURSITE"),
  # and as the banner overlay title (top-left, see .banner-title in site.css).
  short_name: "YOURSITE"
  # Also shown as the banner overlay claim (bottom-right, wraps to multiple
  # lines if needed -- see .banner-claim in site.css) UNLESS banner.claim
  # below is set. This value stays plain text on purpose -- it's reused
  # verbatim in <meta name="description">, the RSS <description> and
  # listing-page descriptions, none of which should ever see raw HTML.
  description: "Personal web/log of Your Name"
  author: "Your Name"
  # Selects locales/<lang>.yml (see lib/i18n.rb). "en" and "cs" ship with the
  # engine; add another locales/<code>.yml to support a different language --
  # any key missing from it falls back to English.
  lang: "en"
  locale: "en_US"
  # The timezone every timestamp this engine writes is expressed in: publish
  # times, "publish now", the date you type into `schedule`. An IANA zone
  # name (see /usr/share/zoneinfo) -- DST is handled for you.
  #
  # Set this whenever the machine's clock isn't in the zone you think in:
  # a server is very often UTC, so without it "schedule 10:30" means 10:30
  # UTC, and a post written after midnight local time can even be dated to
  # the previous day. Omit it to keep using the machine's own zone.
  # Existing posts are unaffected -- each keeps the offset it was written
  # with, so changing this doesn't rewrite history.
  timezone: "Europe/Prague"
  # Overridden by the SITE_BASE_URL environment variable, if set.
  base_url: "https://example.com"
  # Optional: posts per listing page (default 10). Set it ONCE, before
  # the first deploy -- pagination is anchored so page contents never
  # change, and changing this later renumbers every existing page.
  # page_size: 10

banner:
  # Ships with the engine, so a fresh install renders before you've drawn
  # anything -- replace it with your own image and update the size below.
  src: "/assets/images/header.png"
  alt: "Your Site"
  # The file's actual dimensions -- reserves space before the image loads.
  width: 940
  height: 300
  # Optional, independent of each other (default true for both): whether
  # site.short_name / site.description render as text overlaid on the
  # banner image. Turn either off if the image is busy enough on its own.
  # show_title: true
  # show_claim: true
  # Optional: overrides ONLY the banner overlay's claim text -- everywhere
  # else (meta description, RSS, listing pages) keeps using site.description
  # unchanged. Exists because site.description must stay plain text (see
  # above), so it can't carry a manual line break; this field can, since
  # nothing but the banner overlay ever reads it. May contain HTML, same
  # trust level as about.html/footer.note_html below (site.yml is
  # owner-edited config, not visitor input).
  # claim: "First line<br>Second line"

about:
  heading: "About"
  # May contain HTML (links). Inserted inside a <p>.
  html: >-
    A short bio about yourself, with a <a href="https://example.com">link</a>
    if you like.

footer:
  links_heading: "Links"
  links:
    - title: "Example"
      url: "https://example.com"
  note_heading: "Found something here?"
  note_html: >-
    If an article or photo here caught your eye and you'd like to use it
    elsewhere, let me know -- happy to work something out. Please don't
    just copy-paste my content elsewhere without asking!
  copyright: "All rights reserved &copy; 2026"
  social_heading: "Find me on"

# icon = a name from the built-in set: mastodon, pixelfed, linkedin,
# github, bluesky, instagram, threads, youtube, rss, email.
# For another network, use icon_svg with your own <svg>...</svg> instead.
social:
  - name: "Mastodon"
    url: "https://mastodon.social/@yourname"
    icon: "mastodon"
    rel: "me"
  - name: "Bluesky"
    url: "https://bsky.app/profile/yourname.bsky.social"
    icon: "bluesky"
  - name: "GitHub"
    url: "https://github.com/yourname"
    icon: "github"
  - name: "E-mail"
    url: "mailto:you@example.com"
    icon: "email"

# Optional. The comments/announcement network: every published post is
# announced there, and replies to that announcement are the post's
# comments. Configure EITHER mastodon: OR bluesky: -- never both; the
# build refuses a config with two networks, since comments live in
# exactly one place. Omit both sections for a site with no network
# integration at all (no announcements, no comments, no post stats).
#
# The secrets go in env.sh, not here: MASTODON_ACCESS_TOKEN for
# Mastodon, BLUESKY_APP_PASSWORD for Bluesky.
mastodon:
  instance: "mastodon.social"
  # Optional: your instance's status character limit (default 500).
  # Instances routinely raise it -- the auto-toot's excerpt grows to fit.
  # toot_length: 500

# The Bluesky alternative (uncomment this and remove mastodon: above):
# bluesky:
#   handle: "you.bsky.social"
#   # pds: "https://bsky.social"   # only for a self-hosted PDS

# Optional, and each entry independently so. Sidebar widget data is fetched
# by the server (lib/sidebar.rb), not the visitor's browser, and refreshed
# by cron via ./scripts/refresh-sidebar.sh. Omit any entry (or the whole
# `widgets:` key) for a site with no sidebar widgets at all.
widgets:
  toots:
    heading: "Recent toots"
    # instance is optional -- it falls back to mastodon.instance above,
    # so set it only when the widget shows an account living elsewhere.
    # instance: "mastodon.social"
    account_id: "000000000000000000" # numeric Mastodon account id, not the @handle
    limit: 3
  pixelfed:
    heading: "Recent Pixelfed posts"
    feed_url: "https://pixelfed.social/users/yourname.atom"
    limit: 3
  commits:
    heading: "Recent commits"
    username: "yourname"
    limit: 3
  bluesky:
    heading: "Recent Bluesky posts"
    # handle is optional -- it falls back to bluesky.handle above, so set
    # it only when the widget shows an account other than the site's own.
    # handle: "you.bsky.social"
    limit: 3
  rss:
    heading: "Elsewhere"
    # Any RSS 2.0 or Atom feed: another blog, a YouTube channel, a
    # podcast -- or X through a self-hosted Nitter instance.
    feed_url: "https://example.com/feed.xml"
    limit: 3

# Optional. Omit this whole section for a site with no analytics script.
analytics:
  src: "https://analytics.example.com/script.js"
  website_id: "00000000-0000-0000-0000-000000000000"

# Optional. Omit this whole section (or any key inside it) to fall back to
# blog.sh's own blue palette (build/build_blog.rb's DEFAULT_COLORS). Each
# mode only takes these 7 keys -- everything else the CSS needs (card
# background, nav text/border, link/badge hover, search input background)
# is derived from them at build time (see color_properties in
# build/build_blog.rb), not separately configurable, since it's never
# varied independently across any palette this engine has shipped.
# Rebuild after changing any value here: ./blog.sh rebuild.
#
# banner_title / banner_claim are the one exception: two more OPTIONAL
# keys per mode, independent of each other and of the 7 above, for the
# banner overlay text's color (see banner.show_title/show_claim above).
# Default when omitted: nav_bg in light mode, white in dark mode -- the
# same look the banner had before these keys existed.
colors:
  light:
    bg: "#f5f8fa"
    text: "#444a5a"
    meta_text: "#657784"
    accent: "#1da1f2"
    nav_bg: "#eaf5fd"
    border: "#e1e8ed"
    pill_bg: "#d6ecfc"
    # banner_title: "#ffffff"
    # banner_claim: "#ffffff"
  dark:
    bg: "#111111"
    text: "#ffffff"
    meta_text: "#6a7f8c"
    accent: "#4ab3f4"
    nav_bg: "#192734"
    border: "#263340"
    pill_bg: "#16324a"
    # banner_title: "#ffffff"
    # banner_claim: "#ffffff"
