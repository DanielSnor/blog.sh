        <%= draft_banner %><div class="card">
          <article>
            <div class="post-header">
              <%= date_badge(post) %>
              <div class="post-body">
                <% if post['title'] %><h1><%= h(post['title']) %></h1><% end %>
                <% if post['mastodon_url'] %>
                  <div class="post-stats" data-toot-url="<%= h(post['mastodon_url']) %>"></div>
                <% end %>
                <div class="content">
                  <%= content_html %>
                </div>
                <%= tags_html(post) %>
                <% if post['mastodon_url'] %>
                  <div class="comments">
                    <h3><%= h(t('post.comments_heading')) %></h3>
                    <div id="comments" data-toot-url="<%= h(post['mastodon_url']) %>"></div>
                  </div>
                <% end %>
              </div>
            </div>
          </article>
        </div>
        <nav class="pagination back"><a href="/"><%= h(t('post.back_to_list')) %></a></nav>
