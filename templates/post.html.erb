        <%= draft_banner %><div class="card">
          <article>
            <div class="post-header">
              <%= date_badge(post) %>
              <div class="post-body">
                <% if post['title'] %><h1><%= h(post['title']) %></h1><% end %>
                <%= post_stats_html(post) %>
                <div class="content">
                  <%= content_html %>
                </div>
                <%= tags_html(post) %>
                <% if post['mastodon_url'] || post['bluesky_uri'] %>
                  <div class="comments">
                    <h3><%= h(t('post.comments_heading')) %></h3>
                    <div id="comments"<%= comments_attrs(post) %>></div>
                  </div>
                <% end %>
              </div>
            </div>
          </article>
        </div>
        <nav class="pagination back"><a href="/"><%= h(t('post.back_to_list')) %></a></nav>
