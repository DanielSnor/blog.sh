<% if NAV_ITEMS.any? || search %><nav aria-label="<%= h(t('ui.site_nav_label')) %>">
<%# The items come from NAV_ITEMS in build_blog.rb -- either the site's own
    `nav:` list or, with no such key, All plus the content types the site
    has. Rendering them through one loop means the default menu comes out
    byte for byte as it did when it was hardcoded here.
    An empty list takes the items and the toggle with it, which is how a
    site turns the menu off. What is left is a bar carrying nothing but
    the search field -- and since layout.html.erb passes search: true on
    every page, that is what an emptied menu actually looks like today.
    The `|| search` half of the condition is what keeps it standing.
    The odd tag layout is not style: partials compile without an ERB trim
    mode, so a tag's own line breaks would leak into every page as blank
    lines. Same reason nav_current emits the whole aria-current attribute
    inline instead of sitting in a conditional block. (Mind the delimiters
    in this comment too -- an ERB opening tag written inside it ends the
    comment early and dumps the rest into every page. Which is how this
    note came to exist.)
%><% if NAV_ITEMS.any? %>      <button class="nav-toggle" type="button" aria-label="<%= h(t('nav.menu_label')) %>" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <ul>
<% NAV_ITEMS.each do |href, label| %>        <li><a href="<%= h(href) %>"<%= nav_current(href, active) %>><%= h(label) %></a></li>
<% end %>      </ul>
<% end %><% if search %>
      <form class="search-form" action="/search/" method="get" role="search">
        <input type="search" name="q" id="search-q" placeholder="<%= h(t('nav.search_placeholder')) %>" autocomplete="off">
        <button type="submit" aria-label="<%= h(t('nav.search_label')) %>">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
<% end %>
    </nav><% end %>
